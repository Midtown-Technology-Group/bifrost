{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bifrost.invalid/runtime/v1/language-neutral/compatibility.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "input": {}
      },
      "required": [
        "id",
        "input"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "integration": {
          "type": "string",
          "minLength": 1
        },
        "entity_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "entity_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "config": {
          "type": "object"
        }
      },
      "required": [
        "integration",
        "entity_id",
        "entity_name",
        "config"
      ],
      "additionalProperties": false
    },
    "http": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "request": {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE",
                  "HEAD",
                  "OPTIONS"
                ]
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "query": {
                "type": "object"
              }
            },
            "required": [
              "method",
              "url",
              "headers"
            ],
            "additionalProperties": false
          },
          "response": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 599
                  },
                  "json": {}
                },
                "required": [
                  "status",
                  "json"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 599
                  },
                  "body": {
                    "type": "string"
                  },
                  "content_type": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "status",
                  "body",
                  "content_type"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "request",
          "response"
        ],
        "additionalProperties": false
      }
    },
    "expected": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "outcome": {
              "const": "succeeded"
            },
            "result": {}
          },
          "required": [
            "outcome",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "outcome": {
              "const": "failed"
            },
            "error": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "outcome",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "name",
    "workflow",
    "binding",
    "http",
    "expected",
    "invariants"
  ],
  "additionalProperties": false
}
