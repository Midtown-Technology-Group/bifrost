          "type": "VARCHAR(32)",
          "nullable": false,
          "primary_key": false
        },
        "integration_name": {
          "type": "VARCHAR(255)",
          "nullable": false,
          "primary_key": false
        },
        "scope_kind": {
          "type": "VARCHAR(16)",
          "nullable": false,
          "primary_key": false
        },
        "scope_organization_id": {
          "type": "UUID",
          "nullable": true,
          "primary_key": false
        },
        "resolved_organization_id": {
          "type": "UUID",
          "nullable": true,
          "primary_key": false
        },
        "solution_install_id": {
          "type": "UUID",
          "nullable": true,
          "primary_key": false
        }
      },
      "checks": {
        "ck_runtime_sdk_operation_ordinal": "ordinal >= 0 AND ordinal < 2",
        "ck_runtime_sdk_operation_kind": "operation IN ('integration-get','mapping-get') AND scope_kind IN ('default','global','organization')",
        "ck_runtime_sdk_operation_scope": "((scope_kind = 'organization' AND scope_organization_id IS NOT NULL AND resolved_organization_id IS NOT NULL AND scope_organization_id = resolved_organization_id) OR (scope_kind != 'organization' AND scope_organization_id IS NULL)) AND (scope_kind != 'global' OR resolved_organization_id IS NULL)",
        "ck_runtime_sdk_operation_solution": "operation != 'mapping-get' OR solution_install_id IS NULL",
        "ck_runtime_sdk_operation_name_bytes": "octet_length(integration_name) BETWEEN 1 AND 255"
      }
    }
