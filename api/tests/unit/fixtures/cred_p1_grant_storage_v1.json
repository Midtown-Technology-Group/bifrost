        },
        "revocation_reason": {
          "type": "VARCHAR(32)",
          "nullable": true,
          "primary_key": false
        }
      },
      "checks": {
        "ck_runtime_sdk_grant_schema": "schema_version = 'cred-p1/v1' AND source_kind = 'solution-deployment'",
        "ck_runtime_sdk_grant_numbers": "attempt_number >= 1 AND timeout_seconds >= 0",
        "ck_runtime_sdk_grant_flags": "caller_admin IN (0,1) AND caller_provider IN (0,1) AND caller_external IN (0,1) AND source_global_permission IN (0,1)",
        "ck_runtime_sdk_grant_deadline": "((timeout_seconds = 0 AND credential_deadline IS NULL) OR (timeout_seconds > 0 AND credential_deadline IS NOT NULL AND initial_access_expires_at = credential_deadline))",
        "ck_runtime_sdk_grant_revocation": "((revoked_at IS NULL AND revocation_reason IS NULL) OR (revoked_at IS NOT NULL AND revocation_reason IS NOT NULL AND revocation_reason IN ('session_closed','supervisor_replaced','explicit_revoke')))",
        "ck_runtime_sdk_grant_text_bytes": "octet_length(caller_email) <= 320 AND octet_length(caller_name) <= 255",
        "ck_runtime_sdk_claim_token_digest": "claim_token_digest ~ '^[0-9a-f]{64}$'",
        "ck_runtime_sdk_caller_snapshot_digest": "caller_snapshot_digest ~ '^[0-9a-f]{64}$'",
        "ck_runtime_sdk_source_digest": "source_digest ~ '^[0-9a-f]{64}$'",
        "ck_runtime_sdk_operations_digest": "operations_digest ~ '^[0-9a-f]{64}$'",
        "ck_runtime_sdk_grant_digest": "grant_digest ~ '^[0-9a-f]{64}$'",
        "ck_runtime_sdk_source_manifest_digest": "source_manifest_digest ~ '^sha256:[0-9a-f]{64}$'",
        "ck_runtime_sdk_source_resolution_digest": "source_resolution_digest ~ '^sha256:[0-9a-f]{64}$'",
        "ck_runtime_sdk_time_started_at": "started_at IS NULL OR (started_at >= TIMESTAMPTZ '1970-01-01 00:00:00+00' AND started_at <= TIMESTAMPTZ '9999-12-31 23:59:59.999999+00')",
        "ck_runtime_sdk_time_issued_at": "issued_at IS NULL OR (issued_at >= TIMESTAMPTZ '1970-01-01 00:00:00+00' AND issued_at <= TIMESTAMPTZ '9999-12-31 23:59:59.999999+00')",
        "ck_runtime_sdk_time_credential_deadline": "credential_deadline IS NULL OR (credential_deadline >= TIMESTAMPTZ '1970-01-01 00:00:00+00' AND credential_deadline <= TIMESTAMPTZ '9999-12-31 23:59:59.999999+00')",
        "ck_runtime_sdk_time_initial_access_expires_at": "initial_access_expires_at IS NULL OR (initial_access_expires_at >= TIMESTAMPTZ '1970-01-01 00:00:00+00' AND initial_access_expires_at <= TIMESTAMPTZ '9999-12-31 23:59:59.999999+00')",
        "ck_runtime_sdk_time_revoked_at": "revoked_at IS NULL OR (revoked_at >= TIMESTAMPTZ '1970-01-01 00:00:00+00' AND revoked_at <= TIMESTAMPTZ '9999-12-31 23:59:59.999999+00')"
      }
    },
