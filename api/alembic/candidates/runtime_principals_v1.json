  "held_decisions": [
    "Exact role creation/ACL application and authenticated direct/PgBouncer testing require separate explicit approval; no script applies this JSON.",
    "Listed table SELECT includes other owners and organizations inside trusted server SQL principals; this is not API tenancy proof or an untrusted-runtime grant.",
    "Permitted table/column privileges can also permit locks beyond individual owned rows; ordinary row triggers do not establish table-lock isolation. No blanket lock-safety claim.",
    "The artifact NOLOGIN custodian has UPDATE(id) only to preserve fixed NOWAIT row locks. It must have no login/memberships/other function or native ownership.",
    "Existing effective PUBLIC/extension/function/default privileges require exact installed-catalog disposition, not automatic inheritance or blanket revocation.",
    "Selected incumbent ACLs cannot qualify the full Python API/worker/scheduler startup or every existing operation; no deployment DSN switch is authorized.",
    "CRED issuer/renewal/ingress SQL authority remains separately closed; no issuer or SDK SQL role is created here."
  ],
  "required_catalog_evidence": [
    "Actual session_user=current_user for both restricted logins through direct PostgreSQL and supported transaction pooling.",
    "Exact roles/flags/defaults, membership in either direction, database/schema/table/type/function ownership, schema/database effective privileges.",
    "Effective table AND every column ACL, sequences, grant options, defaults, PUBLIC and extension/function capabilities; deny unexplained extras.",
    "Exact Alembic/schema/constraints/keys/FK actions, trigger enabled/order/deferrability and function owner/body/search_path/security/volatility fingerprints.",
    "No RLS or unsupported inheritance/partition/function edges that could hide source or ownership rows.",
    "Row-lock positives and user/source direct mutation negatives under genuine logins; cross-owner writes, role/DDL/credential access and custody bypass negatives.",
    "Original stopped primer/catalog campaigns remain stopped; their prior receipts do not qualify this changed common candidate."
  ],
  "stop_conditions": [
    "An unlisted relation/column/function/sequence is required: report the source consumer and review the exact addition; never grant ALL TABLES/SEQUENCES/FUNCTIONS.",
    "Installed schema or effective authority differs: stop before enabling a writer; do not adopt or repair it automatically."
  ],
