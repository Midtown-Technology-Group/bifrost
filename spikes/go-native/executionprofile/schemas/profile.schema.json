{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bifrost.invalid/runtime/v1/execution-profile/profile.schema.json",
  "title": "PROPOSED execution_profile/v1; not P0",
  "description": "Decoded structure only. Negotiation, correlations, custody, lexical JSON and authority are separate checks. No credentials in frames.",
  "$defs": {
    "Offer": {
      "type": "object",
      "properties": {
        "runtime_incarnation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "supported_protocols": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "artifact_classes": {
          "type": "array",
          "items": {
            "enum": [
              "interpreted-runtime/v1",
              "native-executable/v1",
              "managed-runtime/v1"
            ]
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        }
      },
      "required": [
        "runtime_incarnation_id",
        "supported_protocols",
        "capabilities",
        "artifact_classes"
      ],
      "additionalProperties": false
    },
    "Select": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "bifrost.runtime/v1"
        },
        "capability": {
          "const": "execution_profile/v1"
        },
        "artifact_class": {
          "enum": [
            "interpreted-runtime/v1",
            "native-executable/v1",
            "managed-runtime/v1"
          ]
        }
      },
      "required": [
        "protocol",
        "capability",
        "artifact_class"
      ],
      "additionalProperties": false
    },
    "Prepare": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "https://contracts.bifrost.invalid/runtime/v1/language-neutral/binding.schema.json#/$defs/adapter"
        },
        "artifact": {
          "$ref": "https://contracts.bifrost.invalid/runtime/v1/language-neutral/artifact.schema.json"
        },
        "workload": {
          "type": "object",
          "properties": {
            "input_schema_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "output_schema_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "input": {},
            "deadline_utc": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "input_schema_digest",
            "output_schema_digest",
            "input",
            "deadline_utc"
          ],
          "additionalProperties": false
        },
        "context": {
          "$ref": "https://contracts.bifrost.invalid/runtime/v1/language-neutral/binding.schema.json#/$defs/tenant_context"
        }
      },
      "required": [
        "binding",
        "artifact",
        "workload",
        "context"
      ],
      "additionalProperties": false
    },
    "Prepared": {
      "type": "object",
      "properties": {
        "prepare_message_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "artifact": {
          "$ref": "https://contracts.bifrost.invalid/runtime/v1/language-neutral/artifact.schema.json"
        }
      },
      "required": [
        "prepare_message_id",
        "artifact"
      ],
      "additionalProperties": false
    },
    "Start": {
      "type": "object",
      "properties": {
        "prepare_message_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
