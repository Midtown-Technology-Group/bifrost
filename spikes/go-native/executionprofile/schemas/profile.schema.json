      },
      "required": [
        "prepare_message_id",
        "committed_start_id",
        "remaining_run_ms"
      ],
      "additionalProperties": false
    },
    "Provision": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "https://contracts.bifrost.invalid/runtime/v1/language-neutral/binding.schema.json#/$defs/adapter"
        },
