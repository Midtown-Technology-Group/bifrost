{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bifrost stable release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "version",
    "tag",
    "source",
    "images",
    "compatibility",
    "build",
    "acceptance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "product": {
      "const": "bifrost"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "tag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "const": "Midtown-Technology-Group/bifrost"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "client",
        "worker"
      ],
      "properties": {
        "api": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "digest"
          ],
          "properties": {
            "repository": {
              "const": "ghcr.io/midtown-technology-group/bifrost-api"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "client": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "digest"
          ],
          "properties": {
            "repository": {
              "const": "ghcr.io/midtown-technology-group/bifrost-client"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "worker": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "digest"
          ],
          "properties": {
            "repository": {
              "const": "ghcr.io/midtown-technology-group/bifrost-worker"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cli_contract",
        "database",
        "rollback"
      ],
      "properties": {
        "cli_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current",
            "previous"
          ],
          "properties": {
            "current": {
              "type": "integer",
              "minimum": 1
            },
            "previous": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "migration_heads",
            "upgrade_required"
          ],
          "properties": {
            "migration_heads": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_]+$"
              }
            },
            "upgrade_required": {
              "type": "boolean"
            }
          }
        },
        "rollback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supported",
            "reason"
          ],
          "properties": {
            "supported": {
              "const": false
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "run_id",
        "run_attempt"
      ],
      "properties": {
        "workflow": {
          "const": ".github/workflows/ci.yml"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "acceptance": {
      "const": {
        "kind": "container-content-smoke",
        "platform": "linux/amd64",
        "components": [
          "api",
          "client",
          "worker"
        ]
      }
    }
  }
}
