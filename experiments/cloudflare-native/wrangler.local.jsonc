{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bifrost-cf-lab-local",
  "main": "src/cloudflare.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": { "LAB_ENABLED": "false" },
  "dev": { "ip": "127.0.0.1", "local_protocol": "http", "port": 8787 },
  "durable_objects": {
    "bindings": [{ "name": "ADMISSIONS", "class_name": "ExecutionAdmission" }]
  },
  "migrations": [{ "tag": "lab-v1", "new_sqlite_classes": ["ExecutionAdmission"] }],
  "workflows": [{
    "name": "bifrost-cf-lab-local-inventory",
    "binding": "EXECUTIONS",
    "class_name": "InventoryWorkflow"
  }]
}
