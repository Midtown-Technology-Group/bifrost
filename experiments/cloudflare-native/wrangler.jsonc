{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bifrost-cloudflare-lab",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": { "LAB_ENABLED": "false" },
  "durable_objects": {
    "bindings": [
      { "name": "EXECUTIONS", "class_name": "ExecutionAdmission" }
    ]
  },
  "migrations": [
    { "tag": "lab-v1", "new_sqlite_classes": ["ExecutionAdmission"] }
  ],
  "workflows": [
    {
      "name": "bifrost-cloudflare-lab-echo",
      "binding": "ECHO_WORKFLOW",
      "class_name": "EchoWorkflow"
    }
  ]
}
